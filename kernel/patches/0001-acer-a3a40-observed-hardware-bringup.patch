diff --git a/drivers/input/touchscreen/mediatek/EKTH3386/Kconfig b/drivers/input/touchscreen/mediatek/EKTH3386/Kconfig
index 490f771..1d20b63 100755
--- a/drivers/input/touchscreen/mediatek/EKTH3386/Kconfig
+++ b/drivers/input/touchscreen/mediatek/EKTH3386/Kconfig
@@ -6,4 +6,12 @@ if TOUCHSCREEN_MTK_EKTH3386
 config EKTH3386_CONFIG
 	string "EKTH3386 for Mediatek config"
 
+config ACER_A3A40_BRINGUP_NO_TOUCH_FW
+    bool "Block internal Elan firmware programming during Acer A3-A40 bring-up"
+    default n
+    help
+      Do not auto-program a controller using firmware from the donor source.
+      This blocks the internal update/check/ICE entry points. It is not a
+      complete access-control mechanism for all debug or raw I2C interfaces.
+
 endif
