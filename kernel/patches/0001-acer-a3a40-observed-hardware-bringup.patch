     int i = 0;
@@ -2626,6 +2653,8 @@ IAP_RESTART:
     if(res > 0)	touch_debug(DEBUG_INFO, "[ELAN] Update Firmware successfully!\n");
 
     return res;
+
+#endif
 }
 
