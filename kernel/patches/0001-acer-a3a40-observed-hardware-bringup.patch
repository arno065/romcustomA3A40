     work_lock = 1;
     disable_irq(private_ts->client->irq);
     //wake_lock(&private_ts->wakelock);
@@ -2490,6 +2510,8 @@ int elan_TWO_WIRE_ICE(struct i2c_client *client)  // for driver internal 2-wire
     enable_irq(private_ts->client->irq);
     //wake_unlock(&private_ts->wakelock);
     return 0;
+
+#endif
 }
 // End 2WireICE
 #endif
