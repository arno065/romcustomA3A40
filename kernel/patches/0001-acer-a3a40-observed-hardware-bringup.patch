+
     int res = 0, ic_num = 1;
     int iPage = 0, rewriteCnt = 0; //rewriteCnt for PAGE_REWRITE
     int i = 0;
@@ -1461,6 +1474,8 @@ PAGE_REWRITE:
 
     mutex_unlock(&ktf_mutex);
     return res;   /* 0:sucessfully, 0x80: Recovery, -1: No response */
+
+#endif
 }
 #endif
 // End Firmware Update
