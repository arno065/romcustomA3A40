+
     int rc;
     printk("[elan] enter %s\n",__func__);
     //int New_FW_ID;
@@ -1182,6 +1188,8 @@ no_update_elan_fw:
 	enable_irq(ts->client->irq); 
 	mdelay(500);  
 	return;
+
+#endif
 }
 int EnterISPMode(struct i2c_client *client)
