BOARD_USERDATAIMAGE_PARTITION_SIZE := 26763329536
BOARD_CACHEIMAGE_FILE_SYSTEM_TYPE := ext4
TARGET_USERIMAGES_USE_EXT4 := true

# No separate vendor/super slots were found in the device report.
